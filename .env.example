# AI Lodge showcase. Two parts, two env files:
#   .env        the API (server/, Cloud Run): every key below except NEXT_PUBLIC_API_BASE
#   .env.local  the Next.js app (Vercel): only NEXT_PUBLIC_API_BASE
# No Supabase keys: the demo has no accounts or database (the original setup is in original-supabase/).

# --- Next.js app (Vercel) ---
# The API's URL (Cloud Run). Local: http://localhost:8080
NEXT_PUBLIC_API_BASE=

# --- AI (any OpenAI-compatible chat-completions gateway; AI Lodge uses apiyi). SERVER ONLY. ---
API_BASE_URL=https://api.apiyi.com/v1
# This project's own key (AI Lodge key bot). Old name ANTHROPIC_API_KEY still works.
API_KEY=
# Text model: the weekly story. Old name ANTHROPIC_MODEL still works.
MODEL_NAME=gemini-3.5-flash-lite
# Vision model: handwriting moderation and caption ideas (defaults to MODEL_NAME).
VISION_MODEL_NAME=gemini-3.5-flash-lite
# Optional: caption timeout in ms (default 8000).
CAPTION_TIMEOUT_MS=

# Comma-separated browser origins allowed to call the API (the Vercel URL in production)
CORS_ORIGINS=http://localhost:3000

# --- AI Lodge rate limit (fallbacks; the central control sheet overrides them) ---
# Upstash keys come from the batch's shared env, not this file.
RATE_LIMIT_MODERATE_MAX=10
RATE_LIMIT_CAPTION_MAX=10
RATE_LIMIT_STORY_MAX=3
RATE_LIMIT_WINDOW_SECONDS=432000
