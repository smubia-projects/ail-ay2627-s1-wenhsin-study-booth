{
  "name": "study-booth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:server": "tsx watch --env-file-if-exists=.env server/server.ts",
    "build:server": "esbuild server/server.ts --bundle --platform=node --target=node22 --format=cjs --outfile=server/dist/server.js --log-level=warning",
    "start:server": "node server/dist/server.js",
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "redteam": "node redteam/run.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "@upstash/redis": "^1.39.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tsx": "^4.20.0",
    "typescript": "^5"
  }
}
